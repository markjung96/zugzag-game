# zugzag-game 환경 변수 — 실제 값은 .env.local에 저장 (gitignore 됨)
#
# 주의:
# - zugzag 본체와 같은 Supabase 프로젝트를 공유한다.
# - public.* 는 SELECT-only로 접근. service-role key는 send_revisions INSERT, SSE Proxy RLS bypass에만 사용.
# - NEXTAUTH 쿠키는 .zugzag.com 도메인으로 본체와 공유.

# --- Supabase ---
# 본체와 같은 프로젝트의 URL/키 (qiqzabildtsislyrngfe 등)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxx
# service-role: SSE Proxy에서 RLS bypass 용도. 절대 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxx
# JWT Secret: NextAuth → Supabase Custom JWT broker 서명용. Supabase 대시보드 API Settings에서 복사.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Direct Postgres (Drizzle migration 용) ---
# zugzag_game role (01-schema-and-role.sql에서 생성). public.*에는 SELECT만 가능.
POSTGRES_URL=postgresql://zugzag_game:CHANGE_ME@db.your-project.supabase.co:5432/postgres
# 또는 pooler:
# POSTGRES_URL=postgresql://zugzag_game.your-project:CHANGE_ME@aws-region.pooler.supabase.com:6543/postgres

# --- Admin Postgres (integration test 전용) ---
# ⚠️ ADMIN ONLY — postgres superuser. integration test가 RLS bypass로 fixture INSERT/ROLLBACK 할 때만 사용.
# - dev 머신에만 저장. Vercel/CI 등 production 환경 변수에 절대 등록 금지.
# - tests/integration/setup.ts 한 파일에서만 참조 (ESLint no-restricted-syntax로 강제).
# - 1회성/통합 테스트 전용. 일반 앱 쿼리는 POSTGRES_URL (zugzag_game role, RLS 적용).
# - scoring policy 등 사용자 데이터는 admin UI(P1.2-PolicyCRUD)에서 생성 — 본 변수로 seed 안함.
POSTGRES_URL_ADMIN=postgresql://postgres:CHANGE_ME@db.your-project.supabase.co:5432/postgres

# --- NextAuth (zugzag 본체 패턴 follow — D14) ---
NEXTAUTH_URL=https://games.zugzag.com
NEXTAUTH_COOKIE_DOMAIN=.zugzag.com
# 본체와 동일한 secret 사용 (.zugzag.com 쿠키 공유). 본체의 NEXTAUTH_SECRET 그대로 복사.
NEXTAUTH_SECRET=CHANGE_ME_TO_ZUGZAG_PRIMARY_SECRET

# --- Phase 1.4 e2e 테스트 ---
# NEXTAUTH_TEST_MODE: e2e 테스트에서 Credentials provider 활성화 (문자열 "true" 정확 일치 + NODE_ENV !== "production")
# NEXTAUTH_TEST_MODE=true
# Fallback polling 간격 (ms). 기본 60000. CI에서는 1000으로 오버라이드.
# POLLING_INTERVAL_MS=60000
# e2e fixture IDs — tests/helpers/admin-pg.ts 또는 Supabase SQL Editor로 직접 만든 row의 ID를 복사.
# (DB seed는 폐기됨: scoring policy 및 운영 데이터는 P1.2-PolicyCRUD admin UI에서 생성.)
# SEED_TEST_CREW_ID=
# SEED_TEST_USER_ID=
# SEED_TEST_GYM_ID=
# SEED_TEST_PROBLEM_ID=
# SEED_TEST_SEASON_ID=
# SEED_TEST_SESSION_ID=

# --- (선택) Phase 2 인프라 ---
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
